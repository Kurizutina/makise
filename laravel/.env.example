APP_NAME=Otu-Zan
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:5000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otu-zan-db
DB_USERNAME=root
DB_PASSWORD=
FRONTEND_URL=http://localhost:3000
DRIVER_ACCESS_CODE=DRIVER2024
ADMIN_ACCESS_CODE=ADMIN2024
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
# MAIL_MAILER=log only writes emails (e.g. password resets) to storage/logs/laravel.log
# instead of actually sending them. Set real SMTP credentials to deliver mail for real,
# e.g. Gmail: host smtp.gmail.com, port 587, username your@gmail.com,
# password = a Google "App Password", encryption tls.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
